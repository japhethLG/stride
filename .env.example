# Stride frontend env — copy to .env and fill in (.env is gitignored).
#
# Firebase web app config. When these are ABSENT the app runs on the dev-stub
# auth path (isFirebaseConfigured() === false). Present => real Firebase auth +
# RTDB live tracking. Values come from the Firebase console (Project settings ->
# your web app) / firebase web config JSON.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stride-ae712.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://stride-ae712-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=stride-ae712
VITE_FIREBASE_STORAGE_BUCKET=stride-ae712.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API base URL (NestJS global prefix /api). In dev, Vite proxies /api so this
# can be left unset (defaults to http://localhost:8000).
# VITE_API_BASE_URL=http://localhost:8000
